# ── LLM Provider ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Active Provider (groq or openai) ─────────────────────────────
LLM_PROVIDER=groq

# ── Model Settings ───────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama3-70b-8192
MAX_TOKENS=2048
TEMPERATURE=0.3

# ── App Config ───────────────────────────────────────────────────
APP_NAME=Sustainability Report Generator
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Report Settings ──────────────────────────────────────────────
REPORT_FRAMEWORK=GRI
VALIDATION_TOLERANCE=0.05